# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=utetra_db
MYSQL_USER=utetra
MYSQL_PASSWORD=utetra123

# ===== Port (đổi nếu bị chiếm) =====
# Mặc định: 3306
# Nếu máy bạn đã có MySQL local chạy port 3306 → đổi thành 3307
MYSQL_PORT=3307

# ===== Spring Boot =====
DB_HOST=localhost
DB_PORT=3307
DB_NAME=utetra_db
DB_USER=utetra
DB_PASSWORD=utetra123
# SePay real bank transfer (also set these in Eclipse Run Configurations > Environment).
# .env is not automatically loaded by Spring Boot. Never commit the real webhook key.
SEPAY_BANK=TPBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=
