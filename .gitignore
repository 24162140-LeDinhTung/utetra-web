# =========================================================
#  UTETRA — .gitignore
#  Spring Boot + JSP + Docker + STS
# =========================================================

# ---------- Java ----------
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---------- Maven ----------
target/
build/

# ---------- Gradle (nếu có dùng sau này) ----------
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ---------- IDE ----------
# Eclipse / STS
.settings/
.classpath
.project
.factorypath
.apt_generated/
.apt_generated_tests/
.springBeans
.sts4-cache/
.metadata/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Logs ----------
*.log
logs/
log/

# ---------- Environment / Secrets ----------
.env
.env.local
.env.*.local
*.env.local
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties

# ---------- Cloudinary / Credentials ----------
credentials.properties
firebase-service-account.json
*.p12
*.jks
*.keystore

# ---------- Docker ----------
docker-data/
mysql-data/

# ---------- JSP build artifacts ----------
src/main/webapp/WEB-INF/classes/
src/main/webapp/META-INF/

# ---------- Node (nếu dùng frontend build tool) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------- Test / Coverage ----------
*.exec
jacoco.exec
coverage/

# ---------- Temporary ----------
*.tmp
*.bak
*.swp
*~